{
  "openapi": "3.1.0",
  "info": {
    "title": "student-performance-agent",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/performance_interpretation": {
      "post": {
        "summary": "Execute",
        "operationId": "execute_v1_performance_interpretation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestContract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseContract"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Billed": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "User Id"
          },
          "org_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Org Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "org_id",
          "role"
        ],
        "title": "Billed",
        "description": "Whose daily AI allowance would pay for the interpretation (ADR 0003), taken from the user's verified token."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Observation": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence_ids"
        ],
        "title": "Observation"
      },
      "RequestContract": {
        "properties": {
          "student_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Student Id"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "performance_summary": {
            "items": {
              "$ref": "#/components/schemas/SkillSummary"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Performance Summary"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "skill_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Skill Ids"
          },
          "billed_to": {
            "$ref": "#/components/schemas/Billed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "classroom_id",
          "performance_summary",
          "evidence_ids",
          "skill_ids",
          "billed_to"
        ],
        "title": "RequestContract",
        "description": "Not authorized: always 501."
      },
      "ResponseContract": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          },
          "possible_misconceptions": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Possible Misconceptions"
          },
          "suggested_interventions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Interventions"
          },
          "recommended_skill_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Recommended Skill Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observations",
          "possible_misconceptions",
          "suggested_interventions",
          "recommended_skill_ids"
        ],
        "title": "ResponseContract"
      },
      "SkillSummary": {
        "properties": {
          "skill_id": {
            "type": "string",
            "format": "uuid",
            "title": "Skill Id"
          },
          "attempted": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempted"
          },
          "correct": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct"
          },
          "marks_awarded": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Marks Awarded"
          },
          "marks_possible": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Marks Possible"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "skill_id",
          "attempted",
          "correct",
          "marks_awarded",
          "marks_possible"
        ],
        "title": "SkillSummary",
        "description": "A skill's finalized evidence as Analytics reports it (ADR 0004): questions attempted and answered with full\nmarks, and the points earned out of the points possible, which show part marks."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
