{
  "openapi": "3.1.0",
  "info": {
    "title": "student-performance-agent",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/internal/metrics": {
      "get": {
        "summary": "Operational",
        "operationId": "operational_internal_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/performance_interpretation": {
      "post": {
        "summary": "Interpret",
        "description": "a draft interpretation of the student's finalized results, for their teacher to review; nothing is saved.",
        "operationId": "interpret_v1_performance_interpretation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestContract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseContract"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Evidence": {
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid",
            "title": "Question Id"
          },
          "evaluation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evaluation Id"
          },
          "assessment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Assessment Id"
          },
          "assessment_title": {
            "type": "string",
            "title": "Assessment Title"
          },
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "awarded": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Awarded"
          },
          "possible": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Possible"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "evaluation_id",
          "assessment_id",
          "assessment_title",
          "topic_id",
          "prompt",
          "awarded",
          "possible"
        ],
        "title": "Evidence",
        "description": "a finalized question result an observation cites, for the teacher to check."
      },
      "Observation": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence_ids"
        ],
        "title": "Observation",
        "description": "a statement about the student and the questions (their finalized marks) it rests on."
      },
      "RequestContract": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "student_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Student Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "student_id"
        ],
        "title": "RequestContract",
        "description": "the student to interpret, in a classroom the caller teaches; the agent gathers the evidence itself."
      },
      "ResponseContract": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          },
          "possible_misconceptions": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Possible Misconceptions"
          },
          "suggested_interventions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Interventions"
          },
          "recommended_topic_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Recommended Topic Ids"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "title": "Steps"
          },
          "model_turns": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Model Turns"
          },
          "dropped": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Dropped"
          },
          "requires_teacher_review": {
            "type": "boolean",
            "const": true,
            "title": "Requires Teacher Review",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "student_id",
          "observations",
          "possible_misconceptions",
          "suggested_interventions",
          "recommended_topic_ids",
          "evidence",
          "steps",
          "model_turns",
          "dropped"
        ],
        "title": "ResponseContract",
        "description": "a draft interpretation for the classroom's teacher; it never changes a grade."
      },
      "Step": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ok",
              "refused",
              "failed"
            ],
            "title": "Outcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "reason",
          "target",
          "outcome"
        ],
        "title": "Step",
        "description": "one tool call the agent chose, in order, and what came of it."
      }
    }
  }
}
