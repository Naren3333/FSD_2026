{
  "openapi": "3.1.0",
  "info": {
    "title": "question-generation-agent",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/question_generation": {
      "post": {
        "summary": "Execute",
        "operationId": "execute_v1_question_generation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestContract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseContract"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "GeneratedQuestion": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "answer_key": {
            "type": "string",
            "title": "Answer Key"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "source_references": {
            "items": {
              "$ref": "#/components/schemas/SourceReference"
            },
            "type": "array",
            "title": "Source References"
          },
          "skill_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Skill Ids"
          },
          "validation_metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Validation Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt",
          "answer_key",
          "explanation",
          "source_references",
          "skill_ids",
          "validation_metadata"
        ],
        "title": "GeneratedQuestion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RequestContract": {
        "properties": {
          "document_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Document Ids"
          },
          "skill_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Skill Ids"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "numerical"
            ],
            "title": "Question Type"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "introductory",
              "intermediate",
              "advanced"
            ],
            "title": "Difficulty"
          },
          "count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count"
          },
          "performance_context_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Performance Context Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_ids",
          "skill_ids",
          "classroom_id",
          "question_type",
          "difficulty",
          "count"
        ],
        "title": "RequestContract"
      },
      "ResponseContract": {
        "properties": {
          "questions": {
            "items": {
              "$ref": "#/components/schemas/GeneratedQuestion"
            },
            "type": "array",
            "title": "Questions"
          },
          "requires_teacher_review": {
            "type": "boolean",
            "const": true,
            "title": "Requires Teacher Review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questions",
          "requires_teacher_review"
        ],
        "title": "ResponseContract"
      },
      "SourceReference": {
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "chunk_ordinal": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Chunk Ordinal"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Source Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "revision",
          "chunk_ordinal",
          "source_sha256"
        ],
        "title": "SourceReference"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
