{
  "openapi": "3.1.0",
  "info": {
    "title": "question-generation-agent",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/questions": {
      "post": {
        "summary": "Generate",
        "description": "Questions from the chosen documents, checked, for the teacher to review; nothing is saved.",
        "operationId": "generate_v1_questions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/marking-guidance": {
      "post": {
        "summary": "Marking Guidance",
        "description": "A rubric or accepted answers, and marking points, for a question the teacher wrote; nothing is saved.",
        "operationId": "marking_guidance_v1_marking_guidance_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuidanceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Guidance"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Criterion": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "levels": {
            "items": {
              "$ref": "#/components/schemas/Level"
            },
            "type": "array",
            "title": "Levels"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "levels"
        ],
        "title": "Criterion"
      },
      "DraftQuestion": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "short_answer",
              "free_response"
            ],
            "title": "Type"
          },
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "points": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Points"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "tolerance": {
            "type": "string",
            "const": "",
            "title": "Tolerance",
            "default": ""
          },
          "accepted_answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Answers"
          },
          "case_sensitive": {
            "type": "boolean",
            "title": "Case Sensitive",
            "default": false
          },
          "rubric": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rubric"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_length": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Length"
          },
          "marking_scheme": {
            "items": {
              "$ref": "#/components/schemas/Excerpt"
            },
            "type": "array",
            "title": "Marking Scheme"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Excerpt"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Sources"
          },
          "origin": {
            "type": "string",
            "const": "generated",
            "title": "Origin",
            "default": "generated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt",
          "type",
          "topic_id",
          "points",
          "options",
          "answer",
          "sources"
        ],
        "title": "DraftQuestion",
        "description": "A question as Assessment takes it in a draft, with its sources and origin (ADR 0006)."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Excerpt": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "chunk_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Id"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Excerpt",
        "description": "A passage, as Assessment stores it: from a document (with its ids and page), or written with no ids."
      },
      "GenerateRequest": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "document_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Document Ids"
          },
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "question_types": {
            "items": {
              "type": "string",
              "enum": [
                "multiple_choice",
                "short_answer",
                "free_response"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Question Types"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "introductory",
              "intermediate",
              "advanced"
            ],
            "title": "Difficulty"
          },
          "count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Count"
          },
          "focus": {
            "type": "string",
            "maxLength": 300,
            "title": "Focus",
            "default": ""
          },
          "existing_prompts": {
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "type": "array",
            "maxItems": 50,
            "title": "Existing Prompts",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "document_ids",
          "topic_id",
          "question_types",
          "difficulty",
          "count"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Generated"
            },
            "type": "array",
            "title": "Questions"
          },
          "requested": {
            "type": "integer",
            "title": "Requested"
          },
          "returned": {
            "type": "integer",
            "title": "Returned"
          },
          "dropped": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Dropped"
          },
          "requires_teacher_review": {
            "type": "boolean",
            "const": true,
            "title": "Requires Teacher Review",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questions",
          "requested",
          "returned",
          "dropped"
        ],
        "title": "GenerateResponse"
      },
      "Generated": {
        "properties": {
          "question": {
            "$ref": "#/components/schemas/DraftQuestion"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "evidence",
          "explanation"
        ],
        "title": "Generated"
      },
      "Guidance": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "short_answer",
              "free_response"
            ],
            "title": "Type"
          },
          "accepted_answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Accepted Answers"
          },
          "rubric": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rubric"
              },
              {
                "type": "null"
              }
            ]
          },
          "marking_points": {
            "$ref": "#/components/schemas/Excerpt"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Excerpt"
            },
            "type": "array",
            "title": "Sources"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "requires_teacher_review": {
            "type": "boolean",
            "const": true,
            "title": "Requires Teacher Review",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "accepted_answers",
          "rubric",
          "marking_points",
          "sources",
          "evidence"
        ],
        "title": "Guidance"
      },
      "GuidanceRequest": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "document_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Document Ids"
          },
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt"
          },
          "type": {
            "type": "string",
            "enum": [
              "short_answer",
              "free_response"
            ],
            "title": "Type"
          },
          "points": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Points",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "document_ids",
          "prompt",
          "type"
        ],
        "title": "GuidanceRequest",
        "description": "Marking guidance for a question the teacher wrote, drafted from the documents they choose."
      },
      "Level": {
        "properties": {
          "points": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Points"
          },
          "descriptor": {
            "type": "string",
            "title": "Descriptor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "points",
          "descriptor"
        ],
        "title": "Level"
      },
      "Rubric": {
        "properties": {
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "type": "array",
            "title": "Criteria"
          },
          "model_answer": {
            "type": "string",
            "title": "Model Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "criteria",
          "model_answer"
        ],
        "title": "Rubric"
      }
    }
  }
}
