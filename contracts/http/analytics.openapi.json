{
  "openapi": "3.1.0",
  "info": {
    "title": "analytics",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/performance/{student_id}": {
      "get": {
        "summary": "Performance",
        "operationId": "performance_v1_performance__student_id__get",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Student Id"
            }
          },
          {
            "name": "classroom_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Classroom Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformanceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PerformanceResponse": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/SkillMetric"
            },
            "type": "array",
            "title": "Skills"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "no_finalized_evidence",
              "available"
            ],
            "title": "Evidence Status"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "classroom_id",
          "skills",
          "evidence_status",
          "interpretation"
        ],
        "title": "PerformanceResponse"
      },
      "SkillMetric": {
        "properties": {
          "skill_id": {
            "type": "string",
            "format": "uuid",
            "title": "Skill Id"
          },
          "attempted": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempted"
          },
          "correct": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct"
          },
          "observed_accuracy": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Observed Accuracy"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "insufficient_evidence",
              "observed"
            ],
            "title": "Evidence Status"
          },
          "weakness_indicator": {
            "type": "boolean",
            "title": "Weakness Indicator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "skill_id",
          "attempted",
          "correct",
          "observed_accuracy",
          "evidence_status",
          "weakness_indicator"
        ],
        "title": "SkillMetric"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
