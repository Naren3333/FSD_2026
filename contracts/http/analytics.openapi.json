{
  "openapi": "3.1.0",
  "info": {
    "title": "analytics",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/internal/metrics": {
      "get": {
        "summary": "Operational",
        "operationId": "operational_internal_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/performance": {
      "get": {
        "summary": "Class Performance",
        "description": "one page of the classroom's enrolled students with their topic evidence, for its own teacher only.",
        "operationId": "class_performance_v1_performance_get",
        "parameters": [
          {
            "name": "classroom_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Classroom Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassPerformanceResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/v1/performance/{student_id}": {
      "get": {
        "summary": "Performance",
        "operationId": "performance_v1_performance__student_id__get",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Student Id"
            }
          },
          {
            "name": "classroom_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Classroom Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformanceResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassPerformanceResponse": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset"
          },
          "students": {
            "items": {
              "$ref": "#/components/schemas/StudentPerformance"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Students"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id",
          "total",
          "offset",
          "students",
          "interpretation"
        ],
        "title": "ClassPerformanceResponse",
        "description": "one page of a classroom's enrolled students, in identity's roster order, each with their topic evidence."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "PerformanceResponse": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicMetric"
            },
            "type": "array",
            "title": "Topics"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "no_finalized_evidence",
              "available"
            ],
            "title": "Evidence Status"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "classroom_id",
          "topics",
          "evidence_status",
          "interpretation"
        ],
        "title": "PerformanceResponse"
      },
      "StudentPerformance": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicMetric"
            },
            "type": "array",
            "title": "Topics"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "no_finalized_evidence",
              "available"
            ],
            "title": "Evidence Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "topics",
          "evidence_status"
        ],
        "title": "StudentPerformance"
      },
      "TopicMetric": {
        "properties": {
          "topic_id": {
            "type": "string",
            "format": "uuid",
            "title": "Topic Id"
          },
          "attempted": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempted"
          },
          "correct": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Correct"
          },
          "observed_accuracy": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Observed Accuracy"
          },
          "marks_awarded": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Marks Awarded"
          },
          "marks_possible": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Marks Possible"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "insufficient_evidence",
              "observed"
            ],
            "title": "Evidence Status"
          },
          "weakness_indicator": {
            "type": "boolean",
            "title": "Weakness Indicator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic_id",
          "attempted",
          "correct",
          "observed_accuracy",
          "marks_awarded",
          "marks_possible",
          "evidence_status",
          "weakness_indicator"
        ],
        "title": "TopicMetric",
        "description": "a topic's finalized evidence: questions attempted and answered with full marks, and the marks earned out of the marks possible (which shows part marks)."
      }
    }
  }
}
