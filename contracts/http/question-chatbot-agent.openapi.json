  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "page_start": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Start"
          },
          "page_end": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page End"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "figure"
            ],
            "title": "Kind"
          },
          "source": {
            "type": "string",
            "enum": [
              "pdf",
              "vision"
            ],
            "title": "Source"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "title",
          "page_start",
          "page_end",
          "kind",
          "source",
          "content",
          "image"
        ],
        "title": "Citation",
        "description": "A chunk the answer cites; `[doc:<chunk_id>]` in the message text marks where."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Message": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answered",
                  "no_results",
                  "error",
                  "interrupted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "citations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Citation"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citations"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "outcome",
          "citations",
          "created_at"
        ],
        "title": "Message"
      },
      "MessageList": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "MessageList"
      },
      "NewMessage": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "NewMessage"
      },
      "NewThread": {
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "classroom_id"
        ],
        "title": "NewThread"
      },
      "Thread": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid",
            "title": "Classroom Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher"
            ],
            "title": "Role"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_message_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Message At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "classroom_id",
          "role",
          "title",
          "created_at",
          "last_message_at"
        ],
        "title": "Thread"
      },
      "ThreadList": {
        "properties": {
          "threads": {
            "items": {
              "$ref": "#/components/schemas/Thread"
            },
            "type": "array",
            "title": "Threads"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "threads"
        ],
        "title": "ThreadList"
      }
    }
  }
}
