{
  "openapi": "3.1.0",
  "info": {
    "title": "content",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Chunk": {
        "type": "object",
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_character": {
            "type": "integer",
            "minimum": 0
          },
          "end_character": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "ordinal",
          "text",
          "start_character",
          "end_character"
        ],
        "additionalProperties": false
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "mime_type": {
            "enum": [
              "text/plain",
              "application/pdf"
            ]
          },
          "status": {
            "enum": [
              "extracted",
              "extraction_unsupported",
              "indexing",
              "indexed",
              "failed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "doc_type": {
            "enum": [
              "teaching_material",
              "rubric",
              "marking_scheme"
            ]
          },
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "page_count": {
            "type": "integer",
            "minimum": 0
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 0
          },
          "embedding_model": {
            "type": "string",
            "minLength": 1
          },
          "indexed_at": {
            "type": "string",
            "format": "date-time"
          },
          "failure_reason": {
            "enum": [
              "NO_TEXT_LAYER",
              "ENCRYPTED",
              "CORRUPT",
              "TOO_LARGE",
              "AI_UNAVAILABLE",
              "INTERNAL"
            ]
          }
        },
        "required": [
          "id",
          "classroom_id",
          "title",
          "mime_type",
          "status",
          "revision",
          "sha256",
          "doc_type"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RelatedItem": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "table",
              "figure",
              "text"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{16}\\.png$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "chunk_id",
          "kind",
          "label",
          "page_start",
          "image",
          "content"
        ],
        "additionalProperties": false
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "doc_type": {
            "enum": [
              "teaching_material",
              "rubric",
              "marking_scheme"
            ]
          },
          "section_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "text",
              "table",
              "figure"
            ]
          },
          "source": {
            "enum": [
              "pdf",
              "vision"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{16}\\.png$"
          },
          "score": {
            "type": "number"
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelatedItem"
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "chunk_id",
          "document_id",
          "title",
          "doc_type",
          "section_path",
          "page_start",
          "page_end",
          "content",
          "kind",
          "source",
          "image",
          "score",
          "related"
        ],
        "additionalProperties": false
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 8
          },
          "rerank": {
            "type": "boolean",
            "default": true
          },
          "document_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "doc_types": {
            "type": "array",
            "items": {
              "enum": [
                "teaching_material",
                "rubric",
                "marking_scheme"
              ]
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
        "required": [
          "classroom_id",
          "query"
        ],
        "additionalProperties": false
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "minItems": 0,
            "maxItems": 30
          },
          "rerank_fallback": {
            "type": "boolean"
          }
        },
        "required": [
          "results",
          "rerank_fallback"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
