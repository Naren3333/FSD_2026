        "type": "object",
        "properties": {
          "assessment_id": {
            "type": "string",
            "format": "uuid"
          },
          "released": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "assessment_id",
          "released"
        ],
        "additionalProperties": false
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pending",
              "ready",
              "failed"
            ]
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "points": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "evidence_quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 0,
                  "maxItems": 100
                },
                "rationale": {
                  "type": "string"
                }
              },
              "required": [
                "criterion_id",
                "points",
                "evidence_quotes",
                "rationale"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10
          },
          "awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "feedback": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "model": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "scheme_passages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "status",
          "awarded"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
