{
  "openapi": "3.1.0",
  "info": {
    "title": "grading",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "CriterionScore": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "criterion_id",
          "points"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assessment_id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "finalized"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationEvidence"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "late": {
            "type": "boolean"
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "release_policy": {
            "enum": [
              "on_finalize",
              "manual"
            ]
          },
          "finalized_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "released_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "assessment_id",
          "classroom_id",
          "student_id",
          "status",
          "evidence",
          "answers",
          "late",
          "submitted_at",
          "release_policy",
          "finalized_at",
          "released_at"
        ],
        "additionalProperties": false
      },
      "EvaluationEvidence": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid"
          },
          "topic_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct": {
            "type": "boolean"
          },
          "awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "possible": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "needs_marking": {
            "type": "boolean"
          },
          "marked_by": {
            "enum": [
              "auto",
              "teacher"
            ]
          },
          "criteria": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CriterionScore"
            },
            "minItems": 0,
            "maxItems": 10
          },
          "feedback": {
            "type": "string",
            "maxLength": 2000
          },
          "suggestion": {
            "$ref": "#/components/schemas/Suggestion"
          }
        },
        "required": [
          "question_id",
          "topic_id",
          "correct",
          "awarded",
          "possible"
        ],
        "additionalProperties": false
      },
      "EvaluationPage": {
        "type": "object",
        "properties": {
          "evaluations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluation"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "evaluations",
          "total"
        ],
        "additionalProperties": false
      },
      "FinalizeRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "marks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Mark"
            }
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "GradingCounts": {
        "type": "object",
        "properties": {
          "drafts": {
            "type": "integer",
            "minimum": 0
          },
          "finalized": {
            "type": "integer",
            "minimum": 0
          },
          "unreleased": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "drafts",
          "finalized",
          "unreleased"
        ],
        "additionalProperties": false
      },
      "Mark": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "feedback": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "MarksRequest": {
        "type": "object",
        "properties": {
          "marks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Mark"
            },
            "minProperties": 1
          }
        },
        "required": [
          "marks"
        ],
        "additionalProperties": false
      },
      "OwnEvidence": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid"
          },
          "topic_id": {
            "type": "string",
            "format": "uuid"
          },
          "correct": {
            "type": "boolean"
          },
          "awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "possible": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "feedback": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "question_id",
          "topic_id",
          "correct",
          "awarded",
          "possible"
        ],
        "additionalProperties": false
      },
      "OwnResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assessment_id": {
            "type": "string",
            "format": "uuid"
          },
          "classroom_id": {
            "type": "string",
            "format": "uuid"
          },
          "student_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "finalized"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OwnEvidence"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "late": {
            "type": "boolean"
          },
          "finalized_at": {
            "type": "string",
            "format": "date-time"
          },
          "released_at": {
            "type": "string",
            "format": "date-time"
          }
