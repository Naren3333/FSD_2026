      },
      "ResponseContract": {
        "properties": {
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "vectors": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
