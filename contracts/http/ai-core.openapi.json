    "/v1/ingest": {
      "post": {
        "summary": "Ingest Document",
        "description": "One document (the raw body: a PDF, a PowerPoint deck, Markdown or plain text, as its Content-Type says) \u2192\nchunks with embeddings and the figure crops they point at. Stateless: the caller stores the result. A document\nproblem is a `failed` outcome; a provider outage is an error to retry. The model calls are charged to\n`billed_user` (the teacher who uploaded the document), whatever the outcome.",
        "operationId": "ingest_document_v1_ingest_post",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "title": "Title"
            }
          },
          {
            "name": "billed_user",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Billed User"
            }
          },
          {
            "name": "billed_org",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Billed Org"
            }
          },
          {
            "name": "billed_role",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "student",
                "teacher"
              ],
              "type": "string",
              "title": "Billed Role"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/vnd.openxmlformats-officedocument.presentationml.presentation": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/markdown": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Billed": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "User Id"
          },
          "org_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Org Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "org_id",
          "role"
        ],
        "title": "Billed",
        "description": "The user a call is made for. Callers are trusted service accounts (role ai-client) that took this from the\nuser's verified token: it decides whose allowance pays, never what the call may read."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "capability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "IngestChunk": {
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ordinal"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "embed_text": {
            "type": "string",
            "title": "Embed Text"
          },
          "section_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Path"
          },
          "page_start": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Start"
          },
          "page_end": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page End"
          },
          "token_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Token Count"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "figure"
            ],
            "title": "Kind"
          },
          "source": {
            "type": "string",
            "enum": [
              "pdf",
              "vision"
            ],
            "title": "Source"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "cites": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cites"
          },
          "embedding": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Embedding"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ordinal",
          "content",
          "embed_text",
          "section_path",
          "page_start",
          "page_end",
          "token_count",
          "kind",
          "source",
          "image",
          "label",
          "cites",
          "embedding"
        ],
        "title": "IngestChunk"
      },
      "IngestFigure": {
        "properties": {
          "image": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}\\.png$",
            "title": "Image"
          },
          "png_base64": {
            "type": "string",
            "title": "Png Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image",
          "png_base64"
        ],
        "title": "IngestFigure"
      },
      "IngestResponse": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "indexed",
              "failed"
            ],
            "title": "Outcome"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "NO_TEXT_LAYER",
                  "ENCRYPTED",
                  "CORRUPT",
                  "TOO_LARGE"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "failure_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Detail"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "ocr_page_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ocr Page Count"
          },
          "embedding_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Model"
          },
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/IngestChunk"
            },
            "type": "array",
            "title": "Chunks"
          },
          "figures": {
            "items": {
              "$ref": "#/components/schemas/IngestFigure"
            },
            "type": "array",
            "title": "Figures"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "IngestResponse",
        "description": "`failed` is the document's own problem (ENCRYPTED, CORRUPT, NO_TEXT_LAYER, TOO_LARGE) and retrying will not\nhelp. Provider outages are errors instead, for the caller to retry."
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Passage": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "section_path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Path"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "Passage",
        "description": "A search hit as Content stores it. ai-core builds the text the reranker scores from these parts\n(ingest.passage_text, the same rule that built the embedded text), so the rule lives in one place."
      },
      "RequestContract": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "generate",
              "embed"
            ],
            "title": "Operation"
          },
          "input": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Input"
          },
          "messages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Message"
                },
                "type": "array",
                "maxItems": 50,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 8000.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 1000
          },
          "response_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Schema"
          },
          "schema_name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Name"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "model_profile": {
            "type": "string",
            "const": "default",
            "title": "Model Profile",
            "default": "default"
          },
          "billed_to": {
            "$ref": "#/components/schemas/Billed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation",
          "billed_to"
        ],
        "title": "RequestContract",
        "description": "`embed` takes `input`. `generate` takes `input` (one user message) or `messages`; with `response_schema`\nthe reply is JSON in that strict schema, and with `stream` it arrives as server-sent events."
      },
      "RerankRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "type": "array",
