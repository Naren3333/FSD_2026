{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:identity.classroom.reassigned.v1",
  "description": "A school admin gave a classroom another teacher (ADR 0019); the resource is the classroom and the event's timestamp orders reassignments. Grading bills the classroom's AI marking to teacher_id from then on, draft grades included, and ignores a reassignment older than one it has applied.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "identity.classroom.reassigned.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "teacher_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classroom_id",
        "org_id",
        "teacher_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
