{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:grading.reopened.v1",
  "description": "A teacher reopened a released grade to correct it (ADR 0016); it is a draft again at revision. Consumers withdraw its evidence until a grading.finalized.v3 of that revision or newer, and ignore either event when they already hold a newer revision.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "grading.reopened.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "evaluation_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 2
        }
      },
      "required": [
        "evaluation_id",
        "assessment_id",
        "classroom_id",
        "org_id",
        "student_id",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
