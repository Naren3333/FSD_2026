{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:identity.enrollment.added.v1",
  "description": "A school admin enrolled a student in a classroom; the timestamp is when Identity's database enrolled them, so it orders the student's removals and returns. Grading makes AI suggestions again for work the student submitted before an older removal.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "identity.enrollment.added.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classroom_id",
        "org_id",
        "student_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
