{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:assessment.due_changed.v1",
  "description": "A published assessment's teacher changed its due date, or removed it (null). Grading sets each evaluation's late flag again: late only when submitted after the new due date.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "assessment.due_changed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "assessment_id",
        "classroom_id",
        "org_id",
        "due_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
