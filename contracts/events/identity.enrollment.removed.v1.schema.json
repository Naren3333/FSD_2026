{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:identity.enrollment.removed.v1",
  "description": "A teacher removed a student from a classroom. The student's submissions and grades are kept, and leave the teacher's lists and counts while the student is not enrolled; Grading makes no more AI suggestions for work they submitted before.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "identity.enrollment.removed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classroom_id",
        "org_id",
        "student_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
