{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:content.indexed.v1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "content.indexed.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "doc_type": {
          "enum": [
            "teaching_material",
            "rubric",
            "marking_scheme"
          ]
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "classroom_id",
        "org_id",
        "revision",
        "doc_type",
        "page_count",
        "chunk_count",
        "embedding_model"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
