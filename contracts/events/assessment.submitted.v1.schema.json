{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:assessment.submitted.v1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "assessment.submitted.v1"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "submission_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "type": {
                "enum": [
                  "multiple_choice",
                  "numerical"
                ]
              },
              "options": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "tolerance": {
                "type": "string"
              },
              "skill_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "prompt",
              "type",
              "options",
              "answer",
              "tolerance",
              "skill_id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "submission_id",
        "assessment_id",
        "classroom_id",
        "org_id",
        "student_id",
        "questions",
        "answers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
