{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning:assessment.submitted.v2",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "assessment.submitted.v2"
    },
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "submission_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessment_id": {
          "type": "string",
          "format": "uuid"
        },
        "classroom_id": {
          "type": "string",
          "format": "uuid"
        },
        "org_id": {
          "type": "string",
          "minLength": 1
        },
        "student_id": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "type": {
                "enum": [
                  "multiple_choice",
                  "numerical",
                  "short_answer",
                  "free_response"
                ]
              },
              "options": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "answer": {
                "type": "string"
              },
              "tolerance": {
                "type": "string"
              },
              "accepted_answers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 20
              },
              "case_sensitive": {
                "type": "boolean"
              },
              "rubric": {
                "type": "object",
                "properties": {
                  "criteria": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "levels": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "points": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "descriptor": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "points",
                              "descriptor"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 2,
                          "maxItems": 6
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "levels"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 10
                  },
                  "model_answer": {
                    "type": "string",
                    "maxLength": 5000
                  }
                },
                "required": [
                  "criteria"
                ],
                "additionalProperties": false
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "points": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "skill_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "prompt",
              "type",
              "options",
              "answer",
              "tolerance",
              "points",
              "skill_id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "late": {
          "type": "boolean"
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "release_policy": {
          "enum": [
            "on_finalize",
            "manual"
          ]
        },
        "ai_marking": {
          "type": "boolean"
        },
        "teacher_id": {
          "type": "string"
        }
      },
      "required": [
        "submission_id",
        "assessment_id",
        "classroom_id",
        "org_id",
        "student_id",
        "questions",
        "answers",
        "late",
        "submitted_at",
        "release_policy",
        "ai_marking",
        "teacher_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "timestamp",
    "correlation_id",
    "resource_id",
    "data"
  ],
  "additionalProperties": false
}
