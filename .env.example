# Optional: a new Analytics consumer group, for rebuilding Analytics into a new database (operations.md).
# ANALYTICS_KAFKA_GROUP=analytics-v1

# Optional efficiency controls (ADR 0012). Existing defaults remain bounded.
# GO_DB_POOL_MAX=10
# PYTHON_DB_POOL_MAX=8
# DB_POOL_MIN=1
# SELECTIVE_VISION=true
# CHUNK_TOKENS=600
# CHUNK_OVERLAP=90
# SLIDE_CHUNKS=true
# ADAPTIVE_REWRITE=true
# ADAPTIVE_SEARCH=true
# CHAT_CONTEXT_TOKENS=8000
# Optional aggregate ceiling across all users and all retained ai-core usage (no daily reset).
# AI_TOTAL_SPEND_LIMIT_USD=4
